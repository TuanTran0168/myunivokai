# App
APP_ENV=development
APP_NAME=Myunivokai
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Optional: force a specific env file instead of automatic .env.* loading
# MYUNIVOKAI_ENV_FILE=.env.dev

# API
API_HOST=0.0.0.0
API_PORT=8080
API_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=

# Local Docker database
# DATABASE_URL=postgresql://myunivokai:myunivokai@localhost:5432/myunivokai?sslmode=disable
# DATABASE_DIRECT_URL=postgresql://myunivokai:myunivokai@localhost:5432/myunivokai?sslmode=disable
POSTGRES_USER=myunivokai
POSTGRES_PASSWORD=myunivokai
POSTGRES_DB=myunivokai
MIGRATIONS_DIR=/app/migrations

# AI Provider Switch
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=world-dna-v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Rate limiting
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=8

# Public sharing
SHARE_SLUG_LENGTH=10
