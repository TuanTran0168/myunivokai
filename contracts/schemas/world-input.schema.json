{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldInput",
  "type": "object",
  "required": ["nickname", "interests", "traits", "goal", "mood", "favoriteColors", "preferredWorldStyle"],
  "properties": {
    "nickname": { "type": "string", "minLength": 2, "maxLength": 32 },
    "role": { "type": "string", "maxLength": 80 },
    "interests": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 32 } },
    "traits": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 32 } },
    "goal": { "type": "string", "minLength": 10, "maxLength": 220 },
    "challenge": { "type": "string", "maxLength": 220 },
    "mood": { "type": "string" },
    "favoriteColors": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
    "preferredWorldStyle": { "type": "string" }
  }
}
