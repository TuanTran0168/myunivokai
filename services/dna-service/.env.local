COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
DATABASE_URL=postgresql://myunivokai_dna_app:myunivokai_local_dna@postgres:5432/myunivokai_dna?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_dna_app:myunivokai_local_dna@postgres:5432/myunivokai_dna?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_dna
NATS_PASSWORD=myunivokai_local_dna
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_FETCH_BATCH_SIZE=1
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_PUBLISH_TIMEOUT=5s
NATS_QUERY_TIMEOUT=2500ms
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT=35s
AI_TOTAL_BUDGET=105s
AI_MAX_RETRIES=2
GEMINI_API_KEY=
OPENAI_API_KEY=
