APP_ENV=development
APP_NAME=Myunivokai
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

API_HOST=0.0.0.0
API_PORT=8080
GATEWAY_SHARED_SECRET=

POSTGRES_USER=myunivokai
POSTGRES_PASSWORD=myunivokai
POSTGRES_DB=myunivokai
DATABASE_URL=postgresql://myunivokai:myunivokai@postgres:5432/myunivokai?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai:myunivokai@postgres:5432/myunivokai?sslmode=disable
MIGRATIONS_DIR=/app/migrations

AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=world-dna-v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SHARE_SLUG_LENGTH=10
