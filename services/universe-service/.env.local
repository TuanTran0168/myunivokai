COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://myunivokai_universe_app:myunivokai_local_universe@postgres:5432/myunivokai_universe?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_universe_app:myunivokai_local_universe@postgres:5432/myunivokai_universe?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_universe
NATS_PASSWORD=myunivokai_local_universe
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_QUERY_TIMEOUT=2500ms
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
SERVICE_SHUTDOWN_TIMEOUT=15s
