# App
APP_ENV=development
APP_NAME=Myunivokai
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Optional: force a specific env file instead of automatic .env.* loading
# MYUNIVOKAI_ENV_FILE=.env.dev

# API
API_HOST=0.0.0.0
# API_PORT wins when set; otherwise the platform-injected PORT (Render/Heroku)
# is used, then 8080. On Render leave API_PORT unset.
API_PORT=8080
API_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=

# Production (Neon) — keep sslmode=require; pooled for runtime, direct for
# migrations. Real values belong in the host dashboard (see .env.render).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Render single-container deploys: run goose migrations before the API starts
# (consumed by docker-entrypoint-render.sh in Dockerfile.render).
# RUN_MIGRATIONS_ON_START=true

# Database pool tuning (Go duration strings for the *_LIFETIME/*_IDLE values)
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m

# Local Docker database
# DATABASE_URL=postgresql://myunivokai:myunivokai@localhost:5432/myunivokai?sslmode=disable
# DATABASE_DIRECT_URL=postgresql://myunivokai:myunivokai@localhost:5432/myunivokai?sslmode=disable
POSTGRES_USER=myunivokai
POSTGRES_PASSWORD=myunivokai
POSTGRES_DB=myunivokai
MIGRATIONS_DIR=/app/migrations

# AI Provider Switch
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=world-dna-v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: cap for one WHOLE DNA generation (all repair retries + fallback
# combined), as a Go duration ("90s", "2m"). Unset/0 = 3x AI_TIMEOUT_SECONDS.
# AI_TOTAL_BUDGET=

# Rate limiting
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=8
# Set to true ONLY behind a trusted reverse proxy (e.g. Render) that appends
# the real client IP to X-Forwarded-For; the limiter then keys on that IP.
# Leave false for direct/local traffic or clients could forge the header.
TRUST_PROXY=false

# Public sharing
SHARE_SLUG_LENGTH=10
