# App
APP_ENV=development
APP_NAME=Myunivokai Nature
PUBLIC_WEB_URL=http://localhost:3000/nature
PUBLIC_API_URL=http://localhost:8081

# Optional: force a specific env file instead of automatic .env.* loading
# MYUNIVOKAI_ENV_FILE=.env.dev

# API
API_HOST=0.0.0.0
# API_PORT wins when set; otherwise the platform-injected PORT (Render/Heroku)
# is used, then 8081. On Render leave API_PORT unset.
API_PORT=8081

# Gateway access. Empty keeps standalone local development possible.
# Production requires the same 32+ character value as api-gateway.
GATEWAY_SHARED_SECRET=

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=

# Production (Neon) — point both URLs at nature-service's OWN logical database
# (for example myunivokai_nature), never the universe database. Keep
# sslmode=require; use the pooled URL at runtime and the direct URL for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/myunivokai_nature?sslmode=require
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/myunivokai_nature?sslmode=require

# Render single-container deploys: run goose migrations before the API starts
# (consumed by docker-entrypoint-render.sh in Dockerfile.render).
# RUN_MIGRATIONS_ON_START=true

# Database pool tuning (Go duration strings for the *_LIFETIME/*_IDLE values)
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m

# Local Docker database (published on host port 5433)
# DATABASE_URL=postgresql://myunivokai_nature:myunivokai_nature@localhost:5433/myunivokai_nature?sslmode=disable
# DATABASE_DIRECT_URL=postgresql://myunivokai_nature:myunivokai_nature@localhost:5433/myunivokai_nature?sslmode=disable
POSTGRES_USER=myunivokai_nature
POSTGRES_PASSWORD=myunivokai_nature
POSTGRES_DB=myunivokai_nature
MIGRATIONS_DIR=/app/migrations

# AI Provider Switch. Nature currently wires mock only; Gemini/OpenAI keys are
# reserved for N4 so the environment surface stays aligned with universe-service.
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=forest-dna-v1

# Gemini (reserved until N4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (reserved until N4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: cap for one WHOLE DNA generation (all repair retries + fallback
# combined), as a Go duration ("90s", "2m"). Unset/0 = 3x AI_TIMEOUT_SECONDS.
# AI_TOTAL_BUDGET=

# Public sharing
SHARE_SLUG_LENGTH=10
