# nature-service local development defaults. Copy to .env and adjust.
APP_ENV=development
API_PORT=8081
API_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Leave empty to run on the in-memory store (development only). When set,
# point BOTH urls at nature-service's OWN logical database — a second database
# (e.g. myunivokai_nature) inside the same Neon project as universe-service;
# creating it costs nothing. NEVER point these at the universe database.
# DATABASE_URL=postgresql://user:pass@host-pooler/myunivokai_nature?sslmode=require
# DATABASE_DIRECT_URL=postgresql://user:pass@host/myunivokai_nature?sslmode=require

# mock is the only wired provider until the real-AI round (matching
# universe-service's production setup today).
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock

RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=20
