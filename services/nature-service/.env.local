APP_ENV=development
APP_NAME=Myunivokai Nature
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8081

API_HOST=0.0.0.0
API_PORT=8081
API_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_USER=myunivokai_nature
POSTGRES_PASSWORD=myunivokai_nature
POSTGRES_DB=myunivokai_nature
DATABASE_URL=postgresql://myunivokai_nature:myunivokai_nature@postgres:5432/myunivokai_nature?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_nature:myunivokai_nature@postgres:5432/myunivokai_nature?sslmode=disable
MIGRATIONS_DIR=/app/migrations

AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=forest-dna-v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
SHARE_SLUG_LENGTH=10
