APP_ENV=development
APP_NAME=Myunivokai API Gateway

API_HOST=0.0.0.0
API_PORT=8082
API_ALLOWED_ORIGINS=http://localhost:3000

UNIVERSE_SERVICE_URL=http://localhost:8080
NATURE_SERVICE_URL=http://localhost:8081
GATEWAY_SHARED_SECRET=

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
TRUST_PROXY=false

MAX_REQUEST_BODY_BYTES=65536
PROXY_TIMEOUT=15s
CREATE_WORLD_TIMEOUT=120s
SHARE_TIMEOUT=5s
STATUS_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
SHARE_CACHE_TTL=60s
SHARE_CACHE_MAX_ENTRIES=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=30s
