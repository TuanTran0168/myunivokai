# =============================================================================
# API Gateway — Environment File (.env.example)
# =============================================================================
# Used by services/api-gateway/docker-compose-local.yaml (standalone mode).
# When running via the root docker-compose-local.yaml, these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=Myunivokai API Gateway
API_HOST=0.0.0.0
API_PORT=41800
API_ALLOWED_ORIGINS=http://localhost:41300
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=65536

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CREDENTIALS=
NATS_PUBLISH_TIMEOUT=5s
NATS_REQUEST_TIMEOUT=3s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s

# --- Redis ---
# Use redis://:password@redis:6379/0 inside Docker.
# Use redis://:password@localhost:16379/0 outside Docker.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=myunivokai

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20

# --- Response Cache TTLs ---
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s
