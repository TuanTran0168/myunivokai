# App
APP_ENV=development
APP_NAME=Myunivokai API Gateway

# Optional: force a specific env file instead of automatic .env.* loading
# MYUNIVOKAI_ENV_FILE=.env.dev

# API
API_HOST=0.0.0.0
# API_PORT wins when set; otherwise the platform-injected PORT is used, then
# 8082. On Render leave API_PORT unset.
API_PORT=8082
API_ALLOWED_ORIGINS=http://localhost:3000

# Upstreams. Production values are the HTTPS Render URLs of the two peer APIs.
UNIVERSE_SERVICE_URL=http://localhost:8080
NATURE_SERVICE_URL=http://localhost:8081

# Shared service credential. Development may leave this empty so the services
# remain runnable on their own. Production requires at least 32 characters and
# uses the same generated value in the gateway, universe, and nature services.
GATEWAY_SHARED_SECRET=

# One per-client bucket is shared across both upstream services.
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=20
# Enable only behind a trusted proxy that supplies the client address first in
# X-Forwarded-For. Production validation requires true for the Render deploy.
TRUST_PROXY=false

# Request and route policy
MAX_REQUEST_BODY_BYTES=65536
PROXY_TIMEOUT=15s
CREATE_WORLD_TIMEOUT=120s
SHARE_TIMEOUT=5s
STATUS_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Public share cache
SHARE_CACHE_TTL=60s
SHARE_CACHE_MAX_ENTRIES=1000

# Per-upstream transport circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=30s
