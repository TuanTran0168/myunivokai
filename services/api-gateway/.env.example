# =============================================================================
# API Gateway — Environment File (.env.example)
# =============================================================================
# Used by services/api-gateway/docker-compose-local.yaml (standalone mode).
# When running via the root docker-compose-local.yaml, these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=Myunivokai API Gateway
API_HOST=0.0.0.0
API_PORT=41800
API_ALLOWED_ORIGINS=http://localhost:41300
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=65536

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CREDENTIALS=
NATS_PUBLISH_TIMEOUT=5s
NATS_REQUEST_TIMEOUT=3s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s

# --- Redis ---
# Use redis://:password@redis:6379/0 inside Docker.
# Use redis://:password@localhost:16379/0 outside Docker.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=myunivokai

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20

# --- Admin route group (/api/admin) ---
# This block is NOT optional in standalone mode. The compose file defaults
# ADMIN_ROUTES_ENABLED to true, and enabling the group with an empty
# ADMIN_ACCESS_PUBLIC_KEYS or a wildcard ADMIN_ALLOWED_ORIGIN fails config
# validation — which stops the WHOLE gateway from starting, product routes
# included. Set ADMIN_ROUTES_ENABLED=false if you only want the product API.
ADMIN_ROUTES_ENABLED=true
# Exactly one origin, never a wildcard, in every environment including dev.
ADMIN_ALLOWED_ORIGIN=http://localhost:41900
ADMIN_RATE_LIMIT_REQUESTS_PER_SECOND=10
ADMIN_RATE_LIMIT_BURST=50
# The PUBLIC half of auth-service's AUTH_ACCESS_PRIVATE_KEY, never the private
# key itself. Comma-separated for rotation: list the new key alongside the
# outgoing one until every session has re-authenticated, then drop the old
# one — see notes/ops/admin-key-rotation-drill.md. The value below is the
# public half of the throwaway local-only seed committed in
# services/auth-service/docker-compose-local.yaml; it is never valid in any
# deployed environment.
ADMIN_ACCESS_PUBLIC_KEYS=LevwVSKfMJY075I8dtGksiMif1pouqn7aisvsZPiARI=
ADMIN_TOKEN_VERSION_CACHE_TTL=360h

# --- Response Cache TTLs ---
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s
