# =============================================================================
# Myunivokai — Infrastructure Environment File (.env.example)
# =============================================================================
# This file is used by infra/docker-compose-local.yaml to run ONLY the shared
# infrastructure: PostgreSQL, NATS JetStream, and Redis.
#
# Use this when you want to start infra separately and run individual services
# outside Docker (e.g., with `go run` or `npm run dev`).
#
#   cp .env.example .env.local
#   docker compose --env-file .env.local -f docker-compose-local.yaml up -d
# =============================================================================

# --- Compose Project ---
COMPOSE_PROJECT_NAME=myunivokai-local

# --- Host Ports (mapped to 127.0.0.1) ---
POSTGRES_PORT=15432
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
REDIS_PORT=16379

# --- PostgreSQL: Admin ---
POSTGRES_ADMIN_USER=myunivokai_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin

# --- PostgreSQL: DNA Service Database ---
DNA_DATABASE_NAME=myunivokai_dna
DNA_DATABASE_USER=myunivokai_dna_app
DNA_DATABASE_PASSWORD=change_me_dna

# --- PostgreSQL: Universe Service Database ---
UNIVERSE_DATABASE_NAME=myunivokai_universe
UNIVERSE_DATABASE_USER=myunivokai_universe_app
UNIVERSE_DATABASE_PASSWORD=change_me_universe

# --- PostgreSQL: Nature Service Database ---
NATURE_DATABASE_NAME=myunivokai_nature
NATURE_DATABASE_USER=myunivokai_nature_app
NATURE_DATABASE_PASSWORD=change_me_nature

# --- NATS: Per-Service Credentials (must match nats-server.conf ACL) ---
NATS_GATEWAY_USERNAME=myunivokai_gateway
NATS_GATEWAY_PASSWORD=change_me_gateway
NATS_DNA_USERNAME=myunivokai_dna
NATS_DNA_PASSWORD=change_me_dna
NATS_UNIVERSE_USERNAME=myunivokai_universe
NATS_UNIVERSE_PASSWORD=change_me_universe
NATS_NATURE_USERNAME=myunivokai_nature
NATS_NATURE_PASSWORD=change_me_nature
NATS_BOOTSTRAP_USERNAME=myunivokai_bootstrap
NATS_BOOTSTRAP_PASSWORD=change_me_bootstrap

# --- Redis ---
REDIS_PASSWORD=change_me_redis
